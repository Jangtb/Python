# =============================================================================
# Ecosistema Datos con Datos — variables de entorno
# Copia este archivo como .env.local. Ninguna variable es obligatoria para
# ejecutar en modo demostración: cada integración se activa al completar sus
# claves y la interfaz oculta o explica lo que no está configurado.
# Las variables NEXT_PUBLIC_* se incrustan en el build: cámbialas y recompila.
# =============================================================================

# --- Sitio ---
NEXT_PUBLIC_SITE_URL=http://localhost:3000        # URL pública canónica (sin "/" final). Afecta enlaces de correos, sitemap y Open Graph.
NEXT_PUBLIC_DEFAULT_TIMEZONE=America/Santiago

# --- Datos (adaptador local) ---
DATA_DIR=./.data                                   # Carpeta persistente para db.json. En producción: un volumen persistente.
SEED_DEMO=true                                     # false = base vacía, sin contenido de ejemplo.

# --- Roles ---
ADMIN_EMAILS=                                      # Correos (separados por coma) que reciben rol admin al registrarse.

# --- Correo transaccional (Resend) ---
RESEND_API_KEY=                                    # SECRETA
EMAIL_FROM=                                        # Ej.: "Datos con Datos <hola@tudominio.cl>" (dominio verificado en Resend)
CONTACT_INBOX=                                     # Casilla que recibe las solicitudes de contacto.
EXPOSE_DEV_LINKS=false                             # true: muestra en pantalla los enlaces que irían por correo (solo pruebas, nunca en producción real).

# --- Boletín (Brevo) ---
BREVO_API_KEY=                                     # SECRETA
BREVO_LIST_ID=                                     # ID numérico de la lista donde se sincronizan los confirmados.

# --- Antispam (Cloudflare Turnstile, opcional) ---
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=                              # SECRETA

# --- Contacto ---
NEXT_PUBLIC_WHATSAPP_NUMBER=                       # Formato internacional solo dígitos, ej. 569XXXXXXXX. Vacío = sin botones de WhatsApp.
NEXT_PUBLIC_SCHEDULING_URL=                        # Ej.: https://cal.com/tu-usuario/30min. Vacío = sin agenda en línea.

# --- Redes y audiovisual ---
NEXT_PUBLIC_YOUTUBE_URL=
NEXT_PUBLIC_INSTAGRAM_URL=
NEXT_PUBLIC_LINKEDIN_URL=
NEXT_PUBLIC_TIKTOK_URL=

# --- Analítica (Plausible, sin cookies) ---
NEXT_PUBLIC_PLAUSIBLE_DOMAIN=                      # Ej.: datoscondatos.cl
NEXT_PUBLIC_PLAUSIBLE_SRC=                         # Opcional (instancia propia). Por defecto: script.tagged-events.js de plausible.io
